        "License": "GPL-3.0-or-later",
        "Name": "Plasma Stats",
        "Name[zh_CN]": "Plasma Stats 系统监控",
        "Version": "1.0.0",
        "Website": "https://github.com/local/plasma-stats"
    },
    "X-Plasma-API-Minimum-Version": "6.0",
    "X-Plasma-NotificationArea": "true",
    "X-Plasma-NotificationAreaCategory": "Hardware",
